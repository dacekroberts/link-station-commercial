__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env
.DS_Store

# Local-only: dev server launch config, custom skills/subagents. Kept out
# of the repo deliberately - these are local workflow tooling, not part
# of the deployed app or its documented process.
.claude/

# Raw downloads are large and re-downloadable. Keep the README that
# explains how to fetch them, not the files themselves.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Intermediate files are regenerable from raw.
data/processed/*
!data/processed/.gitkeep

# Outputs ARE committed - Streamlit Cloud needs them at runtime,
# and the pipeline does not run there.

# Internal development notes. Kept locally as project history, but this is
# a public portfolio repo read by hiring managers, and a session-by-session
# build log is working material rather than part of the deliverable.
# Still reachable in git history before 2026-09-20 - purge that too if the
# file should be gone entirely, not just delisted.
Initial Build Development Context.md

# Working review files - analyst scratch, not part of the deliverable.
naics_sample_3x_review.csv
personal_exposure_flagged.csv

# Portable skill write-up passed over from the sibling multi-city project.
# Local working material, and it belongs in .claude/skills/ rather than the
# repo root - see its own header.
passover_name_filtering_skill.md

# Local safety copy of pre-history-rewrite state. Large, and specific to
# this machine.
.backups/
